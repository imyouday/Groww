# Secrets and machine-specific values only (architecture.md §18.2).
# Copy to .env and fill in. The demo runs WITHOUT any of these: generation.provider=auto falls
# back to the extractive generator, which still returns cited, ground-truth answers.
# .env is git-ignored and must never be committed.

# Optional. Any OpenAI-compatible /chat/completions endpoint works (free tier is fine).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# When false (the default) query text is never written to stdout or any log, and PII is never
# logged. Set true only for local debugging.
LOG_QUERIES=false
